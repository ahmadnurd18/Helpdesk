<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="LaporanPeminjamanDetail" language="groovy" pageWidth="1120" pageHeight="595" orientation="Landscape" columnWidth="1080" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="bb9e1b20-b41b-40b6-8efa-d5fbc73637a9">
	<property name="ireport.zoom" value="1.3310000000000013"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tanggalMulai" class="java.sql.Date" isForPrompting="false"/>
	<parameter name="tanggalAkhir" class="java.sql.Date" isForPrompting="false"/>
	<parameter name="userID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="userRole" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT
    p.ID_Peminjaman,
    p.Tanggal_Peminjaman,
    p.Tanggal_Pengembalian,
    p.Status_Peminjaman,
    pg.Nama_Pegawai,
    pr.ID_Perangkat,
    pr.Jenis_Perangkat,
    pr.Merek,
    pr.No_Serial,
    pr.Model_Perangkat
FROM peminjaman p
JOIN pegawai pg ON p.Pegawai_ID_Pegawai = pg.ID_Pegawai
JOIN detail_peminjaman dp ON p.ID_Peminjaman = dp.Peminjaman_ID_Peminjaman
JOIN perangkat pr ON dp.Perangkat_ID_Perangkat = pr.ID_Perangkat
WHERE ($P{tanggalMulai} IS NULL OR p.Tanggal_Peminjaman >= $P{tanggalMulai})
  AND ($P{tanggalAkhir} IS NULL OR p.Tanggal_Peminjaman <= $P{tanggalAkhir})
  AND ($P{userRole} = 'admin' OR p.User_ID_User = $P{userID})
ORDER BY p.Tanggal_Peminjaman DESC, p.ID_Peminjaman, pr.ID_Perangkat]]>
	</queryString>
	<field name="ID_Peminjaman" class="java.lang.String"/>
	<field name="Tanggal_Peminjaman" class="java.sql.Date"/>
	<field name="Tanggal_Pengembalian" class="java.sql.Date"/>
	<field name="Status_Peminjaman" class="java.lang.String"/>
	<field name="Nama_Pegawai" class="java.lang.String"/>
	<field name="ID_Perangkat" class="java.lang.String"/>
	<field name="Jenis_Perangkat" class="java.lang.String"/>
	<field name="Merek" class="java.lang.String"/>
	<field name="No_Serial" class="java.lang.String"/>
	<field name="Model_Perangkat" class="java.lang.String"/>
