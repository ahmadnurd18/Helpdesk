<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Laporan_Tiket_Helpdesk" pageWidth="1120" pageHeight="595" orientation="Landscape" columnWidth="1080" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="11bd51bb-aa78-429c-a2a2-8f515262cd42">
	<parameter name="userID" class="java.lang.String"/>
	<parameter name="tanggalMulai" class="java.sql.Date"/>
	<parameter name="tanggalAkhir" class="java.sql.Date"/>
	<parameter name="periodeText" class="java.lang.String">
		<defaultValueExpression><![CDATA["Semua Tanggal"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    t.ID_Tiket,
    t.Judul_Tiket,
    t.Deskripsi_Tiket,
    t.Prioritas_Tiket,
    DATE_FORMAT(t.StartDate, '%d/%m/%Y') AS StartDate,
    DATE_FORMAT(t.EndDate, '%d/%m/%Y') AS EndDate,
    t.Status_Tiket,
    u.Nama_Full AS Nama_User,
    COALESCE(p.Nama_Pegawai, '-') AS Nama_Pegawai
FROM tiket t
JOIN user u ON t.User_ID_User = u.ID_User
LEFT JOIN pegawai p ON t.Pegawai_ID_Pegawai = p.ID_Pegawai
WHERE ($P{userID} IS NULL OR t.User_ID_User = $P{userID})
  AND ($P{tanggalMulai} IS NULL OR t.StartDate >= $P{tanggalMulai})
  AND ($P{tanggalAkhir} IS NULL OR t.StartDate <= $P{tanggalAkhir})
ORDER BY t.StartDate DESC]]>
	</queryString>
	<field name="ID_Tiket" class="java.lang.String"/>
	<field name="Judul_Tiket" class="java.lang.String"/>
	<field name="Deskripsi_Tiket" class="java.lang.String"/>
	<field name="Prioritas_Tiket" class="java.lang.String"/>
	<field name="StartDate" class="java.lang.String"/>
	<field name="EndDate" class="java.lang.String"/>
	<field name="Status_Tiket" class="java.lang.String"/>
	<field name="Nama_User" class="java.lang.String"/>
	<field name="Nama_Pegawai" class="java.lang.String"/>
